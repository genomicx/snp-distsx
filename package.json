{
  "name": "snp-distsx",
  "version": "0.1.0",
  "description": "Browser-based pairwise SNP distance matrix calculator from aligned FASTA files",
  "type": "module",
  "license": "GPL-3.0-only",
  "author": "Nabil-Fareed Alikhan <nabil@happykhan.com> (https://www.happykhan.com)",
  "homepage": "https://snp-distsx.genomicx.org",
  "repository": {
    "type": "git",
    "url": "https://github.com/genomicx/snp-distsx.git"
  },
  "bugs": {
    "url": "https://github.com/genomicx/snp-distsx/issues"
  },
  "keywords": [
    "snp-dists",
    "snp-distsx",
    "bioinformatics",
    "genomics",
    "phylogenomics",
    "outbreak",
    "webassembly"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
